{
  "schema_version": "1.0",
  "rules": [
    {
      "rule_id": "check_deleted_records_percent",
      "validator": "DELETED_RECORDS_PERCENT",
      "params": {
        "threshold": 5
      }
    },
    {
      "rule_id": "check_quarter_and_year_series_present",
      "validator": "SQL_VALIDATOR",
      "params": {
        "query": "SELECT SUM(CASE WHEN LOWER(StatVar) LIKE '%quarteronchange%' THEN 1 ELSE 0 END) AS quarter_count, SUM(CASE WHEN LOWER(StatVar) LIKE '%yearonchange%' THEN 1 ELSE 0 END) AS year_count FROM stats",
        "condition": "quarter_count > 0 AND year_count > 0"
      }
    },
    {
      "rule_id": "check_gdp_growth_value_range",
      "validator": "SQL_VALIDATOR",
      "params": {
        "query": "SELECT StatVar, MinValue, MaxValue FROM stats",
        "condition": "MinValue >= -100 AND MaxValue <= 100"
      }
    },
    {
      "rule_id": "check_units_are_percent",
      "validator": "SQL_VALIDATOR",
      "params": {
        "query": "SELECT StatVar, Units FROM stats",
        "condition": "LOWER(COALESCE(Units, '')) LIKE '%percent%'"
      }
    }
  ]
}
