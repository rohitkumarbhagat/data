Node: dcid:TreasurySecurity
typeOf: dcid:Class
subClassOf: dcid:Bond
name: "TreasurySecurity"
description: "United States Treasury securities are government debt instruments issued by the United States Department of the Treasury to finance government spending as an alternative to taxation."
descriptionUrl: "https://en.wikipedia.org/wiki/United_States_Treasury_security"

Node: dcid:TreasuryBill
typeOf: dcid:Class
subClassOf: dcid:TreasurySecurity
name: "TreasuryBill"
description: "A Treasury Bill is a zero-coupon Treasury security that matures in one year or less. Treasury Bills are bought at a discount of the par value and eventually redeemed at that par value to create a positive yield to maturity."
descriptionUrl: "https://en.wikipedia.org/wiki/United_States_Treasury_security#Treasury_bill"

Node: dcid:TreasuryNote
typeOf: dcid:Class
subClassOf: dcid:TreasurySecurity
name: "TreasuryNote"
description: "A Treasury Note is a Treasury security with a maturity of 2,3,5,7,or 10 years,and a coupon payment every six months."
descriptionUrl: "https://en.wikipedia.org/wiki/United_States_Treasury_security#Treasury_note"

Node: dcid:TreasuryBond
typeOf: dcid:Class
subClassOf: dcid:TreasurySecurity
name: "TreasuryBond"
description: "A Treasury Bond is a Treasury security with a maturity of thirty years,and a coupon payment every six months."
descriptionUrl: "https://en.wikipedia.org/wiki/United_States_Treasury_security#Treasury_bond"

