Node: dcid:BiogenicEmissionSource
typeOf: dcid:EmissionSourceTypeEnum
name: "BiogenicEmissionSource"
description: "Biogenic emission sources are emissions that come from natural sources. Most types are widespread and ubiquitous contributors to background air chemistry. Often only the emissions from vegetation and soils are included,but other relevant sources include volcanic emissions,lightning,and sea salt."
descriptionUrl: "https://www.epa.gov/air-emissions-modeling/biogenic-emission-sources"

Node: dcid:NonBiogenicEmissionSource
typeOf: dcid:EmissionSourceTypeEnum
name: "NonBiogenicEmissionSource"
description: "Non-biogenic emission sources are emissions that come from the combustion of fossil fuels,from the use of sorbent,from some other non-combustion processes,and the portion of CO2 from the fossil fuel component of fuels with both fossil and biomass components (i.e.,MSW and tires)."
descriptionUrl: "https://ccdsupport.com/confluence/pages/viewpage.action?pageId=191398007"

