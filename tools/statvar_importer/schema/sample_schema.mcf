description: "An energy unit of measure equivalent to one thousand volts"

Node: dcid:Btu
typeOf: dcid:EnergyUnitOfMeasure
name: "Btu"
description: "British thermal unit (Btu) is the quantity of heat required to raise the temperature of 1 pound of liquid water by 1 degree Fahrenheit at the temperature at which water has its greatest density (approximately 39 degrees Fahrenheit)."
descriptionUrl: "https://www.eia.gov/tools/glossary/index.php?id=B"

Node: dcid:MMBtu
typeOf: dcid:EnergyUnitOfMeasure
name: "MMBtu"
description: "Unit of energy that equals a million British thermal units (Btu)."

Node: dcid:QuadrillionBtu
