subClassOf: dcid:Enumeration
name: "CountyClassificationEnum"
description: "County type is based on the \"Rural-Urban Continuum Codes\" developed by the U.S. Department of Agriculture. See https://www.ers.usda.gov/data-products/rural-urban-continuum-codes.aspx"

Node: dcid:USDA_LargeMetro
typeOf: dcid:CountyClassificationEnum
name: "USDA_LargeMetro"
description: "Large metropolitan statistical areas have a total population of 1 million or more."

Node: dcid:USDA_SmallMetro
typeOf: dcid:CountyClassificationEnum
name: "USDA_SmallMetro"
description: "Small metropolitan statistical areas have a total population of fewer than 1 million."

Node: dcid:USDA_Nonmetro
typeOf: dcid:CountyClassificationEnum
name: "USDA_Nonmetro"
description: "Nonmetropolitan counties were classified according to the aggregate size of their urban population. Nonmetropolitan areas include counties in micropolitan statistical areas and counties outside of both metropolitan and micropolitan statistical areas and are classified as follows: \urbanized","\ \less urbanized","\ and \completely rural.\"

Node: dcid:USDA_NonmetroUrbanized
typeOf: dcid:CountyClassificationEnum
name: "USDA_NonmetroUrbanized"
description: "Nonmetropolitan county with a population of 20,000 or more in urbanized areas."

Node: dcid:USDA_NonmetroLessUrbanized
typeOf: dcid:CountyClassificationEnum
name: "USDA_NonmetroLessUrbanized"
description: "Nonmetropolitan county with a population of at least 2,500 but fewer than 20,000 in urbanized areas."

Node: dcid:USDA_NonmetroCompletelyRural
typeOf: dcid:CountyClassificationEnum
name: "USDA_NonmetroCompletelyRural"
description: "Nonmetropolitan county with a population of fewer than 2,500 in urbanized areas."

