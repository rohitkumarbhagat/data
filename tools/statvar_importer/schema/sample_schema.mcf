Node: dcid:MeteorologicalEvent
typeOf: dcid:Class
subClassOf: dcid:Event
name: "MeteorologicalEvent"
description: "Meteorological or atmospheric events include lightning,flash floods,etc; violent meteorological events are commonly known as storms."

Node: dcid:CycloneEvent
typeOf: dcid:Class
subClassOf: dcid:MeteorologicalEvent
name: "CycloneEvent"
description: "A cyclone is a type of storm with a large scale air mass that rotates around a strong center of low atmospheric pressure."

Node: dcid:WildlandFireEvent
typeOf: dcid:Class
subClassOf: dcid:Event
name: "WildlandFireEvent"
description: "Wildland fire is any non-structure fire that occurs in an area in which development is essentially non-existent,except for roads,railroads,power lines,and similar transportation facilities."
descriptionUrl: "https://www.nifc.gov/prevEdu/comm_guide/ch2.html"

Node: dcid:PrescribedFireEvent
typeOf: dcid:Class
subClassOf: dcid:Event
name: "PrescribedFireEvent"
description: "A wildland fire originating from a planned ignition in accordance with applicable laws,policies,and regulations to meet specific objectives."
descriptionUrl: "https://www.nwcg.gov/term/glossary/prescribed-fire"

Node: dcid:FireIncidentComplexEvent
typeOf: dcid:Class
subClassOf: dcid:Event
name: "FireIncidentComplexEvent"
description: "Two or more distinct incidents in the same general area that,by management action,are managed under a single incident commander or unified command in order to improve efficiency and simplify incident management processes."
descriptionUrl: "https://www.nwcg.gov/term/glossary/incident-complex"

Node: dcid:FireEvent
typeOf: dcid:Class
subClassOf: dcid:Event
name: "FireEvent"
description: "An occurrence of a fire that burns through wildland,building,dwelling or other structure.  Often involves the use of fire department resources to contain it."
descriptionUrl: "https://en.wikipedia.org/wiki/Fire"

Node: dcid:StormEpisode
typeOf: dcid:Class
subClassOf: dcid:MeteorologicalEvent
name: "StormEpisode"
description: "A continuous disturbance of the atmosphere marked by wind and usually by rain,snow,hail,sleet,or thunder and lightning."

Node: dcid:StormEvent
typeOf: dcid:Class
subClassOf: dcid:MeteorologicalEvent
name: "StormEvent"
description: "A singular event of rain,snow,hail,sleet,etc. within a storm episode."

