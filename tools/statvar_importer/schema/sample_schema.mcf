## CYCLONE CLASSIFICATION ENUMS
Node: dcid:CycloneTypeEnum
typeOf: dcid:Class
subClassOf: dcid:Enumeration
name: "CycloneTypeEnum"
description: "Different classifications of cyclones."

Node: dcid:TropicalCyclone
typeOf: dcid:CycloneTypeEnum
name: "TropicalCyclone"
description: "A warm-core non-frontal synoptic-scale cyclone,originating over tropical or subtropical waters,with organized deep convection and a closed surface wind circulation about a well-defined low-pressure center. Once formed,a tropical cyclone is maintained by the extraction of heat energy from the ocean at high temperature and heat export at the low temperatures of the upper troposphere."
descriptionUrl: "https://www.nhc.noaa.gov/aboutgloss.shtml"

Node: dcid:ExtratropicalCyclone
typeOf: dcid:CycloneTypeEnum
name: "ExtratropicalCyclone"
description: "A cyclone of any intensity for which the primary energy source is baro clinic,that is,results from the temperature contrast between warm and cold air masses."
descriptionUrl: "https://www.nhc.noaa.gov/aboutgloss.shtml"

Node: dcid:SubtropicalCyclone
typeOf: dcid:CycloneTypeEnum
name: "SubtropicalCyclone"
description: "A non-frontal low-pressure system that has characteristics of both tropical and extra tropical cyclones."
descriptionUrl: "https://www.nhc.noaa.gov/aboutgloss.shtml"

Node: dcid:RemnantLow
typeOf: dcid:CycloneTypeEnum
name: "RemnantLow"
description: "A low-pressure system that is neither a tropical cyclone,a subtropical cyclone,nor an extratropical cyclone (of any intensity)."
descriptionUrl: "https://www.aoml.noaa.gov/hrd/hurdat/hurdat2-format.pdf"

Node: dcid:TropicalWave
typeOf: dcid:CycloneTypeEnum
name: "TropicalWave"
description: "A trough or cyclonic curvature maximum in the trade-wind easterlies (of any intensity). The wave may reach maximum amplitude in the lower middle troposphere."
descriptionUrl: "https://www.aoml.noaa.gov/hrd/hurdat/hurdat2-format.pdf"

Node: dcid:TropicalDisturbance
typeOf: dcid:CycloneTypeEnum
name: "TropicalDisturbance"
description: "A discrete tropical weather system of apparently organized convection -- generally 100 to 300 nmi in diameter -- originating in the tropics or subtropics,having a non frontal migratory character,and maintaining its identity for 24 hours or more. It may or may not be associated with a detectable perturbation of the wind field."
descriptionUrl: "https://www.nhc.noaa.gov/aboutgloss.shtml"

