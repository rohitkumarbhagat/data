Node: dcid:cycloneTrackType
typeOf: dcid:Property
name: "cycloneTrackType"
description: "Type of cyclone track record."
domainIncludes: dcid:CycloneEvent
rangeIncludes: dcid:IBTrACS_CycloneTrackTypeEnum

Node: dcid:IBTrACS_CycloneTrackTypeEnum
typeOf: dcid:Class
subClassOf: dcid:Enumeration
name: "IBTrACS_CycloneTrackTypeEnum"
description: "Types of cyclone track records used by IBTrACS."

Node: dcid:IBTrACS_MainCycloneTrack
typeOf: dcid:IBTrACS_CycloneTrackTypeEnum
name: "MainCycloneTrack"
description: "Primary track associated with a storm system. This is a track that has had some reanalysis and is higher quality than provisional data."
descriptionUrl: "https://www.ncdc.noaa.gov/ibtracs/pdf/IBTrACS_v04_column_documentation.pdf"

Node: dcid:IBTrACS_ProvisionalCycloneTrack
typeOf: dcid:IBTrACS_CycloneTrackTypeEnum
name: "ProvisionalCycloneTrack"
description: "Real time data used to populate the position and other parameters of this system. This is a provisional track that will be replaced when reanalysis of the storm is performed (usually within 2 years of the storm's occurrence)."
descriptionUrl: "https://www.ncdc.noaa.gov/ibtracs/pdf/IBTrACS_v04_column_documentation.pdf"

Node: dcid:IBTrACS_ProvisionalSpurCycloneTrack
typeOf: dcid:IBTrACS_CycloneTrackTypeEnum
name: "ProvisionalSpurCycloneTrack"
description: "Real time data (see ProvisionalCycloneTrack) but due to differences in positions between various inputs,algorithm can not identify accurate position. When counting storms,these should not likely be counted. These should be rare for PROVISIONAL data."
descriptionUrl: "https://www.ncdc.noaa.gov/ibtracs/pdf/IBTrACS_v04_column_documentation.pdf"

Node: dcid:IBTrACS_SpurCycloneTrack
typeOf: dcid:IBTrACS_CycloneTrackTypeEnum
name: "SpurCycloneTrack"
description: "Usually short lived tracks associated with a main track and often represents alternate positions at the beginning of a system. Can also represent actual system interactions (e.g.,Fujiwhara interactions)."
descriptionUrl: "https://www.ncdc.noaa.gov/ibtracs/pdf/IBTrACS_v04_column_documentation.pdf"

## Fire type enums
Node: dcid:FireIncidentTypeEnum
typeOf: dcid:Class
subClassOf: dcid:Enumeration
name: "FireIncidentTypeEnum"
description: "Types of incidents and planned events to which the interagency wildland fire community responds."
descriptionUrl: "https://www.nwcg.gov/data-standards-approved"

Node: dcid:Wildfire
typeOf: dcid:FireIncidentTypeEnum,dcid:EmissionSourceEnum
name: "Wildfire"
description: "An unplanned,unwanted wildland fire including unauthorized human-caused fires,escaped wildland fire use events,escaped prescribed fire projects,and all other wildland fires where the objective is to put the fire out (NIFC.gov)."
descriptionUrl: "https://www.nifc.gov/prevEdu/comm_guide/ch2.html"

Node: dcid:WildlandFireUse
typeOf: dcid:FireIncidentTypeEnum
name: "WildlandFireUse"
description: "The application of the appropriate management response to naturally ignited wildland fires to accomplish specific resource management objectives in pre-defined designated areas outlined in Fire Management Plans (NIFC.gov)."
descriptionUrl: "https://www.nifc.gov/prevEdu/comm_guide/ch2.html"

Node: dcid:PrescribedFire
typeOf: dcid:FireIncidentTypeEnum,dcid:EmissionSourceEnum,dcid:FireCauseEnum,dcid:FireCauseSpecificEnum
name: "PrescribedFire"
description: "Any fire ignited by management actions to meet specific objectives,e.g.,the establishment/maintenance of healthy forests and grasslands or the enhancement of certain wildlife habitat. Prescribed fire is a well-established practice on public and private lands throughout the world,and is based on years of scientific research. Resource managers carefully calculate meteorological factors,fuels,slope of land,and other relevant conditions in planning prescribed fires. Utmost care is taken to protect human life and property,manage impacts of smoke,protect historical and archeological resources,and protect the ecological integrity of the physical and biological resources (NIFC.gov)."
descriptionUrl: "https://www.nifc.gov/prevEdu/comm_guide/ch2.html"

Node: dcid:ComplexFire
typeOf: dcid:FireIncidentTypeEnum
name: "ComplexFire"

