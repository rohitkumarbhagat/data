Node: dcid:UPI
typeOf: dcid:FinancialProductEnum
name: "Unified Payments Interface"
description: "It is a revolutionary,user-friendly,real time payment solution that facilitates inter-bank transactions,and enables greater digital payments adoption in the country."
descriptionUrl: "https://www.npci.org.in/what-we-do/upi/product-overview"

Node: dcid:NationalAutomatedClearingHouseCredit
typeOf: dcid:FinancialProductEnum
name: "National Automated Clearing House Credit"
description: "It is a payment service used by an institution for affording credits to a large number of beneficiaries in their bank accounts for the payment of dividend,interest,salary,pension etc."
descriptionUrl: "https://www.npci.org.in/what-we-do/nach/product-overview"

Node: dcid:NationalAutomatedClearingHouseDebit
typeOf: dcid:FinancialProductEnum
name: "National Automated Clearing House Debit"
description: "NACH Debit is the product of NPCI to provide a better & efficient Mandate based debit services to the banks."
descriptionUrl: "https://www.npci.org.in/what-we-do/nach/product-overview"

Node: dcid:NPCI
typeOf: dcid:FinancialProductEnum
name: "National Payments Corporation of India"
description: "It was incorporated in 2008 as an umbrella organization for operating retail payments and settlement systems in India."
descriptionUrl: "https://www.npci.org.in/npci-profile"

Node: dcid:NationalAutomatedClearingHouse
typeOf: dcid:FinancialProductEnum
name: "National Automated Clearing House"
description: "It is used for making bulk transactions towards distribution of subsidies,dividends,interest,salary,pension etc."
descriptionUrl: "https://www.npci.org.in/what-we-do/nach/product-overview"

Node: dcid:NationalFinancialSwitch
typeOf: dcid:FinancialProductEnum
name: "National Financial Switch"
description: "It is the largest network of shared automated teller machines (ATMs) in India."
descriptionUrl: "https://www.npci.org.in/what-we-do/nfs/product-overview"

Node: dcid:AadhaarEnabledPaymentSystem
typeOf: dcid:FinancialProductEnum
name: "Aadhaar Enabled Payment System"
description: "It allows the merchant to accept payment from a customer of any bank,by authenticating the customer's biometrics."
descriptionUrl: "https://www.npci.org.in/what-we-do/aeps/product-overview"

Node: dcid:AadhaarEnabledPaymentSystemBHIMAadhaarPay
typeOf: dcid:FinancialProductEnum
name: "Aadhaar Enabled Payment System BHIM Aadhaar Pay"
description: "It enables Merchants to receive digital payments from customers over the counter through Aadhaar Authentication."
descriptionUrl: "https://www.npci.org.in/what-we-do/bhim-aadhaar/product-overview"

Node: dcid:AadhaarEnabledPaymentSystemCashWithdrawal
typeOf: dcid:FinancialProductEnum
name: "Aadhaar Enabled Payment System Cash Withdrawal"
description: "Enables customers to withdraw cash using their Aadhaar number and biometric authentication."
descriptionUrl: "https://www.npci.org.in/what-we-do/bhim-aadhaar/product-overview"

Node: dcid:AadhaarEnabledPaymentSystemFundsTransfer
typeOf: dcid:FinancialProductEnum
name: "Aadhaar Enabled Payment System Funds Transfer"
description: "Enables customers to trander funds using their Aadhaar number and biometric authentication."
descriptionUrl: "https://www.npci.org.in/what-we-do/bhim-aadhaar/product-overview"

Node: dcid:AadharPaymentBridgeSystem
typeOf: dcid:FinancialProductEnum
name: "Aadhar Payment Bridge System"
description: "It is used for crediting DBT transactions for Government/ Government agency disbursements."

Node: dcid:ChequeTruncationSystem
typeOf: dcid:FinancialProductEnum
name: "Cheque Truncation System"
description: "The Cheque Truncation System (CTS) involves halting the physical movement of the cheque and its replacement by an image/s of the instrument and the corresponding data contained in the MICR line."
descriptionUrl: "https://www.npci.org.in/what-we-do/cts/product-overview"

Node: dcid:ImmediatePaymentService
typeOf: dcid:FinancialProductEnum
name: "Immediate Payment Service"
description: "IMPS provides robust & real time fund transfer which offers an instant,24X7,interbank electronic fund transfer service that could be accessed on multiple channels like Mobile,Internet,Branch,ATM and SMS."
descriptionUrl: "https://www.npci.org.in/what-we-do/imps/product-overview"

Node: dcid:NationalElectronicTollCollection
typeOf: dcid:FinancialProductEnum
name: "National Electronic Toll Collection"
description: ,"NETC FASTag offers the convenience of cashless payment along with benefits like savings on fuel and time as the customer does not has to stop at the toll plaza."
descriptionUrl: "https://www.npci.org.in/what-we-do/imps/product-overview","https://www.npci.org.in/what-we-do/netc-fastag/product-overview"

Node: dcid:UnifiedPaymentsInterface
typeOf: dcid:FinancialProductEnum
name: "Unified Payments Interface"
description: ,"Unified Payments Interface is an instant real-time payment system developed by NPCI to facilitate inter-bank transactions through mobile phones."
descriptionUrl: "https://www.npci.org.in/what-we-do/imps/product-overview","https://www.npci.org.in/what-we-do/upi/product-overview"

Node: dcid:BharatInterfaceForMoney
typeOf: dcid:FinancialProductEnum
name: "Bharat Interface For Money"
description: "Bharat Interface for Money (BHIM) is a payment app that lets you make simple,easy and quick transactions using Unified Payments Interface (UPI)."
descriptionUrl: "https://www.bhimupi.org.in/about-bhim"

Node: dcid:RuPayPointOfSales
typeOf: dcid:FinancialProductEnum
name: "RuPay Point Of Sales"
description: "The objective of RuPay Contactless is to provide a mechanism for Low-Value Payments (LVPs) within the gambit of electronic payments."
descriptionUrl: "https://www.rupay.co.in/rupay-for-business"

Node: dcid:TransactionApproved
typeOf: dcid:TransactionStatusEnum
name: "Transaction Approved"
description: "The transaction is approved."

Node: dcid:TransactionBusinessDecline
typeOf: dcid:TransactionStatusEnum
name: "Transaction Business Decline"
description: "Transaction declines that are attributable to business decisions by stakeholders participating in the transaction."

Node: dcid:TransactionTechnicalDecline
typeOf: dcid:TransactionStatusEnum
name: "Transaction Technical Decline"
description: "Transaction declines that are attributable to technical shortcomings like connectivity issues,switch unavailability,incorrect message data elements etc are classified under TD."

Node: dcid:ProductUp
typeOf: dcid:ProductStatusEnum
name: "Product Up"
description: "The transaction status is successful."

Node: dcid:ProductDown
typeOf: dcid:ProductStatusEnum
name: "Product Down"
description: "The transaction status is down due to various reasons."

Node: dcid:ProductIncident
typeOf: dcid:ProductStatusEnum
name: "Product Incident"

Node: dcid:ProductUnscheduledDowntime
typeOf: dcid:TransactionCauseEnum
name: "Product Unscheduled Downtime"

Node: dcid:MeasurementMethodEnum
typeOf: dcid:Class
subClassOf: dcid:Enumeration
name: "MeasurementMethodEnum"
description: "Measurement methods used by various observations in Data Commons."

Node: dcid:StatisticSourceEnum
typeOf: dcid:Class
subClassOf: dcid:MeasurementMethodEnum
name: "StatisticSourceEnum"
description: "Measurement methods used solely for distinguishing observations that come from different sources about the same statistic."

Node: dcid:CovidTrackingProject
typeOf: dcid:StatisticSourceEnum
name: "CovidTrackingProject"

Node: dcid:GeoNamesTotalPopulation
typeOf: dcid:StatisticSourceEnum
name: "GeoNamesTotalPopulation"
description: "Measurement method for total population measured by geonames.org."

Node: dcid:BondYieldMeasurementEnum
typeOf: dcid:Class
subClassOf: dcid:MeasurementMethodEnum
name: "BondYieldMeasurementEnum"
description: "Indicates the method of computing yields of bonds,such as constant maturity"

Node: dcid:ConstantMaturityRate
typeOf: dcid:BondYieldMeasurementEnum
name: "ConstantMaturityRate"
description: "Indicates that the yield data are extrapolated against a yield curve,which relates the yield on a security to its time to maturity,to estimate the yield of the bond if it had exactly some maturity"
descriptionUrl: "https://www.investopedia.com/terms/c/cmtindex.asp"

Node: dcid:Wikipedia
typeOf: dcid:StatisticSourceEnum
name: "Wikipedia"
description: "Measurement method of Wikipedia statistics."

Node: dcid:PriceIndexChainingEnum
typeOf: dcid:Class
subClassOf: dcid:MeasurementMethodEnum
name: "PriceIndexChainingEnum"
description: "An enumeration of chained and unchained price index measurement methods."

Node: dcid:BLSUnchained
typeOf: dcid:PriceIndexChainingEnum
name: "BLSUnchained"
description: "Indicates regular unchained price index series such as CPI-U and CPI-W"
descriptionUrl: "https://www.bls.gov/cpi/additional-resources/chained-cpi.htm"

Node: dcid:BLSChained
typeOf: dcid:PriceIndexChainingEnum
name: "BLSChained"
description: "Indicates chained price index series that uses more current weights of goods and services and that more accurately reflects how consumers respond to changes in relative prices."
descriptionUrl: "https://www.bls.gov/cpi/additional-resources/chained-cpi.htm"

Node: dcid:GoogleMapsCommunityMobility
typeOf: dcid:StatisticSourceEnum
name: "GoogleMapsCommunityMobility"
description: "Represents the methods used by Google to compute how visits and length of stay at different places have changed over time compared to a baseline."

Node: dcid:EurostatRegionalStatistics
typeOf: dcid:StatisticSourceEnum
name: "EurostatRegionalStatistics"
description: "Measurement method for regional statistics collected by eurostat.org."

Node: dcid:EurostatRegionalStatistics_LowReliability
typeOf: dcid:StatisticSourceEnum
name: "EurostatRegionalStatistics_LowReliability"
description: "Low reliability in series statistics collected by eurostat.org. The series is set to low reliability if one or more observations inseries are marked as low reliable in source. An estimate is published with a flag low reliability if it is based on 20 to 49 sample observations or if non-response for the item concerned exceeds 20% and is lower or equal to 50%."

Node: dcid:EurostatRegionalStatistics_DefinitionDiffers
typeOf: dcid:StatisticSourceEnum
name: "EurostatRegionalStatistics_DefinitionDiffers"
description: "Measurement method of statistics collected by eurostat.org where the national definition differs from the definition in methodological guidelines and this deviation is supposed to have impact on the results. The series is set to deinition differs if one or more observations inseries are marked as deinition differs in source."
descriptionUrl: "https://ec.europa.eu/eurostat/cache/metadata/en/hlth_det_esms.htm"

