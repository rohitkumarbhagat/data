Node: dcid:InitialClaimExcludingIntrastateTransitional
typeOf: dcid:UnemploymentInsuranceClaimTypeEnum
name: "InitialClaimExcludingIntrastateTransitional"
description: "Used by State UI programs. Includes intrastate initial claims and interstate initial claims filed from the agent state,but not intrastate transitional claims."
descriptionUrl: "https://wdr.doleta.gov/directives/attach/ETAH/ETHand401_4th_s01.pdf"

Node: dcid:InitialClaim
typeOf: dcid:UnemploymentInsuranceClaimTypeEnum
name: "InitialClaim"
description: "An initial request for unemployment benefits."

Node: dcid:ContinuedClaim
typeOf: dcid:UnemploymentInsuranceClaimTypeEnum
name: "ContinuedClaim"
description: "A claim to continue receiving unemployment benefits."

Node: dcid:StateUnemploymentInsurance
typeOf: dcid:UnemploymentInsuranceProgramEnum
name: "StateUnemploymentInsurance"
description: "Unemployment insurance provided by a state (first-level administrative country subdivision) or state-equivalent."

Node: dcid:UCFENoStateUnemploymentInsurance
typeOf: dcid:UnemploymentInsuranceProgramEnum
name: "UCFENoStateUnemploymentInsurance"
description: "Represents Unemployment Compensation for Federal Employees,not in conjunction with any State Unemployment Insurance program."

Node: dcid:UCXOnly
typeOf: dcid:UnemploymentInsuranceProgramEnum
name: "UCXOnly"
description: "Represents Unemployment Compensation for Ex-servicemembers,not in conjunction with any other unemployment insurance program."

Node: dcid:ShortTimeCompensation
typeOf: dcid:UnemploymentInsuranceProgramEnum
name: "ShortTimeCompensation"
description: "Short-Time Compensation (STC),also known as work sharing or shared-work program,is an alternative to layoffs for employers experiencing a reduction in available work."
descriptionUrl: "https://oui.doleta.gov/unemploy/docs/stc_fact_sheet.pdf"

Node: dcid:StateUnemploymentInsuranceOrShortTimeCompensation
typeOf: dcid:UnemploymentInsuranceProgramEnum
name: "StateUnemploymentInsuranceOrShortTimeCompensation"
description: "Represents any State Unemployment Insurance program or Short Time Compensation program."

Node: dcid:WithCoveredEmployment
typeOf: dcid:UnemploymentInsuranceStatusEnum
name: dcid:WithCoveredEmployment
description: "Qualified for unemployment insurance benefits via conditions such as: earned a specified amount of wages or must have worked a certain number of weeks or calendar quarters in covered employment,or must have met some combination of the wage and employment requirements within his/her base period."
descriptionUrl: "https://oui.doleta.gov/unemploy/pdf/partnership.pdf"

Node: dcid:MovingAverage1WeekWindow
typeOf: dcid:MovingAverageWindowEnum
name: dcid:MovingAverage1WeekWindow
description: "Moving average with a window of 1 week. A statistic attributed to any given day would be the average of that day plus the preceding 6 days. This does NOT make any statement about the frequency of observations."

Node: dcid:ScaledForPartTimeUnemploymentBenefits
typeOf: dcid:UnemploymentInsuranceMeasurementEnum
name: dcid:ScaledForPartTimeUnemploymentBenefits
description: "For Short-Time Compensation program observations. Indicates that the measurement of number of STC claims has been scaled down to the equivalent of the full time layoff initial claims that would have taken place if not for the STC program. That is,if the agreement is for a 20 percent reduction in each STC claimant's hours,then each of these claimants initial claim would represent 20 percent of an equivalent full time layoff initial claim."
descriptionUrl: "https://wdr.doleta.gov/directives/attach/ETAH/ETHand401_4th_s01.pdf"

